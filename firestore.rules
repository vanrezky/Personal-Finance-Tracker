rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/households/$(householdId)) &&
             request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function isHouseholdOwner(householdId) {
      return isHouseholdMember(householdId) &&
             get(/databases/$(database)/documents/households/$(householdId)).data.ownerUid == request.auth.uid;
    }

    function hasApprovedJoinRequest(householdId, userId) {
      return exists(/databases/$(database)/documents/households/$(householdId)/joinRequests/$(userId)) &&
             get(/databases/$(database)/documents/households/$(householdId)/joinRequests/$(userId)).data.householdId == householdId &&
             get(/databases/$(database)/documents/households/$(householdId)/joinRequests/$(userId)).data.userUid == userId &&
             get(/databases/$(database)/documents/households/$(householdId)/joinRequests/$(userId)).data.status == 'approved';
    }

    function isValidHousehold(data) {
      return data.keys().hasAll(['name', 'members', 'createdAt', 'ownerUid']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.members is list && data.members.size() > 0 && data.members.size() <= 20 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50 &&
             data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 100 &&
             (!('payday' in data) || (data.payday is int && data.payday >= 1 && data.payday <= 31));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['householdId', 'type', 'amount', 'category', 'date', 'createdAt', 'authorUid']) &&
             data.householdId is string && data.householdId.size() > 0 && data.householdId.size() <= 100 &&
             data.type in ['income', 'expense'] &&
             data.amount is number && data.amount > 0 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.date is string && data.date.size() > 0 && data.date.size() <= 50 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50 &&
             data.authorUid is string && data.authorUid.size() > 0 && data.authorUid.size() <= 100 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1000)) &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 200)) &&
             (!('receiptImage' in data) || (data.receiptImage is string && data.receiptImage.size() <= 1000000)) &&
             (!('captureFingerprint' in data) ||
               (data.captureFingerprint is string && data.captureFingerprint.matches('^[a-f0-9]{64}$') &&
                data.amount is int && data.amount <= 9007199254740991));
    }

    function isValidPendingCapture(data, householdId, captureId) {
      return data.keys().hasAll(['householdId', 'type', 'amount', 'category', 'note', 'date', 'createdAt', 'authorUid', 'authorName', 'captureFingerprint']) &&
             data.keys().hasOnly(['householdId', 'type', 'amount', 'category', 'note', 'date', 'createdAt', 'authorUid', 'authorName', 'captureFingerprint']) &&
             data.householdId == householdId &&
             data.type in ['income', 'expense'] &&
             data.amount is int && data.amount > 0 && data.amount <= 9007199254740991 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.note is string && data.note.size() <= 1000 &&
             data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50 &&
             data.authorUid is string && data.authorUid.size() > 0 && data.authorUid.size() <= 100 &&
             data.authorName is string && data.authorName.size() <= 200 &&
             data.captureFingerprint == captureId && captureId.matches('^[a-f0-9]{64}$');
    }

    function isValidJoinRequest(data, householdId, userId) {
      return data.keys().hasAll(['householdId', 'userUid', 'displayName', 'status', 'createdAt']) &&
             data.keys().hasOnly(['householdId', 'userUid', 'displayName', 'status', 'createdAt']) &&
             data.householdId == householdId &&
             data.userUid == userId &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.status in ['pending', 'approved', 'denied'] &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50;
    }

    function unchangedCaptureFingerprint(oldData, newData, transactionId) {
      return (
               !('captureFingerprint' in oldData) && !('captureFingerprint' in newData)
             ) || (
               'captureFingerprint' in oldData &&
               'captureFingerprint' in newData &&
               newData.captureFingerprint == oldData.captureFingerprint &&
               newData.captureFingerprint == transactionId
             );
    }

    function isValidShoppingItem(data) {
      return data.keys().hasAll(['name', 'estimatedAmount', 'createdAt', 'updatedAt', 'authorUid', 'isChecked']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.estimatedAmount is number && data.estimatedAmount >= 0 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50 &&
             data.authorUid is string && data.authorUid.size() > 0 && data.authorUid.size() <= 100 &&
             data.isChecked is bool &&
             (!('quantity' in data) || (data.quantity is number && data.quantity >= 0)) &&
             (!('unit' in data) || (data.unit is string && data.unit.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('checkedAt' in data) || (data.checkedAt is string && data.checkedAt.size() <= 50)) &&
             (!('lastTransactionId' in data) || (data.lastTransactionId is string && data.lastTransactionId.size() > 0 && data.lastTransactionId.size() <= 100)) &&
             (!('lastImportedAt' in data) || (data.lastImportedAt is string && data.lastImportedAt.size() > 0 && data.lastImportedAt.size() <= 50));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() > 0 && data.email.size() <= 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 200)) &&
             (!('authProvider' in data) || data.authProvider in ['google', 'password']) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50)) &&
             (!('currentHouseholdId' in data) || (data.currentHouseholdId is string && data.currentHouseholdId.size() > 0 && data.currentHouseholdId.size() <= 100));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /households/{householdId} {
      allow get: if isHouseholdMember(householdId);
      allow list: if false;

      allow create: if isAuthenticated() &&
                    isValidHousehold(request.resource.data) &&
                    request.auth.uid in request.resource.data.members &&
                    request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAuthenticated() &&
                    isValidHousehold(request.resource.data) &&
                    request.resource.data.ownerUid == resource.data.ownerUid &&
                    (
                      (
                        isHouseholdMember(householdId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payday']) &&
                        request.resource.data.members == resource.data.members &&
                        request.resource.data.name == resource.data.name &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        (request.resource.data.payday == resource.data.payday || request.auth.uid == resource.data.ownerUid)
                      ) ||
                      (
                        !(request.auth.uid in resource.data.members) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
                        request.resource.data.members.hasAll(resource.data.members) &&
                        request.resource.data.members.size() == resource.data.members.size() + 1 &&
                        request.auth.uid in request.resource.data.members &&
                        request.resource.data.name == resource.data.name &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.payday == resource.data.payday &&
                        hasApprovedJoinRequest(householdId, request.auth.uid)
                      )
                    );
      allow delete: if false;

      match /joinRequests/{userId} {
        allow get: if isAuthenticated() && (request.auth.uid == userId || isHouseholdOwner(householdId));
        allow list: if isHouseholdOwner(householdId);
        allow create: if isAuthenticated() &&
                      request.auth.uid == userId &&
                      !(request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members) &&
                      isValidJoinRequest(request.resource.data, householdId, userId) &&
                      request.resource.data.status == 'pending';
        allow update: if isAuthenticated() &&
                      isValidJoinRequest(request.resource.data, householdId, userId) &&
                      request.resource.data.householdId == resource.data.householdId &&
                      request.resource.data.userUid == resource.data.userUid &&
                      (
                        (isHouseholdOwner(householdId) &&
                         resource.data.status == 'pending' &&
                         request.resource.data.displayName == resource.data.displayName &&
                         request.resource.data.status in ['approved', 'denied'] &&
                         request.resource.data.createdAt == resource.data.createdAt) ||
                        (request.auth.uid == userId &&
                         resource.data.status == 'denied' &&
                         request.resource.data.status == 'pending')
                      );
        allow delete: if false;
      }

      match /pendingCaptures/{captureId} {
        allow read: if isHouseholdMember(householdId) && resource.data.authorUid == request.auth.uid;
        allow create: if isHouseholdMember(householdId) &&
                      request.resource.data.authorUid == request.auth.uid &&
                      isValidPendingCapture(request.resource.data, householdId, captureId);
        allow update: if false;
        allow delete: if isHouseholdMember(householdId) && resource.data.authorUid == request.auth.uid;
      }

      match /transactions/{transactionId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) &&
                      isValidTransaction(request.resource.data) &&
                      request.resource.data.householdId == householdId &&
                      request.resource.data.authorUid == request.auth.uid &&
                      (!('captureFingerprint' in request.resource.data) || request.resource.data.captureFingerprint == transactionId);
        allow update: if isHouseholdMember(householdId) &&
                      isValidTransaction(request.resource.data) &&
                      request.resource.data.householdId == householdId &&
                      request.resource.data.authorUid == resource.data.authorUid &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      unchangedCaptureFingerprint(resource.data, request.resource.data, transactionId);
        allow delete: if isHouseholdMember(householdId);
      }

      match /categories/{categoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) &&
                      request.resource.data.keys().hasAll(['name', 'type', 'createdAt', 'authorUid']) &&
                      request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
                      request.resource.data.type in ['income', 'expense'] &&
                      request.resource.data.createdAt is string && request.resource.data.createdAt.size() > 0 && request.resource.data.createdAt.size() <= 50 &&
                      request.resource.data.authorUid == request.auth.uid;
        allow update: if isHouseholdMember(householdId) &&
                      request.resource.data.keys().hasAll(['name', 'type', 'createdAt', 'authorUid']) &&
                      request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
                      request.resource.data.type == resource.data.type &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.authorUid == resource.data.authorUid;
        allow delete: if isHouseholdMember(householdId);
      }

      match /shoppingMonths/{monthKey}/items/{itemId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) &&
                      isValidShoppingItem(request.resource.data) &&
                      request.resource.data.authorUid == request.auth.uid;
        allow update: if isHouseholdMember(householdId) &&
                      isValidShoppingItem(request.resource.data) &&
                      request.resource.data.authorUid == resource.data.authorUid &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isHouseholdMember(householdId);
      }
    }
  }
}
